    "wires": []
  },

  {
    "id": "mqtt_in_ems",
    "type": "mqtt in",
    "z": "tab_ems",
    "name": "ESP32 EMS/UCT",
    "topic": "EMS/UCT",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt_broker_local",
    "x": 120,
    "y": 120,
    "wires": [["parse_json"]]
  },

  {
    "id": "mqtt_broker_local",
    "type": "mqtt-broker",
    "name": "Aedes Local 192.168.1.8",
    "broker": "192.168.1.8",
    "port": "1883",
    "clientid": "NodeRED-EMS-Sub",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },

  {
    "id": "inject_test",
    "type": "inject",
    "z": "tab_ems",
    "name": "Test Data",
    "props": [{"p": "payload"}],
    "repeat": "",
    "crontab": "",
    "once": false,
    "topic": "",
    "payload": "{\"Voltage\":229.2,\"Current\":0.09,\"Frequency\":49.76,\"PowerFactor\":1.01,\"Energy\":0.02}",
    "payloadType": "json",
    "x": 120,
    "y": 180,
    "wires": [["parse_json"]]
  },

  {
    "id": "parse_json",
    "type": "function",
    "z": "tab_ems",
    "name": "Parse JSON",
    "func": "var d = msg.payload;\n\nif (typeof d !== 'object' || d === null) {\n    node.warn('Invalid payload: ' + JSON.stringify(msg.payload));\n    return null;\n}\n\nmsg.payload = {\n    Voltage:     parseFloat((d.Voltage     || 0).toFixed(1)),\n    Current:     parseFloat((d.Current     || 0).toFixed(2)),\n    Frequency:   parseFloat((d.Frequency   || 0).toFixed(2)),\n    PowerFactor: parseFloat((d.PowerFactor || 0).toFixed(2)),\n    Energy:      parseFloat((d.Energy      || 0).toFixed(2)),\n    timestamp:   new Date().toLocaleString('en-IN')\n};\n\nflow.set('ems_latest', msg.payload);\n\nnode.status({\n    fill: 'green',\n    shape: 'dot',\n    text: 'V:' + msg.payload.Voltage + 'V | I:' + msg.payload.Current + 'A | ' + msg.payload.timestamp\n});\n\nreturn msg;",
    "outputs": 1,
    "x": 360,
    "y": 140,
    "wires": [["split_5", "debug_node", "alert_check"]]
  },

  {
    "id": "debug_node",
    "type": "debug",
    "z": "tab_ems",
    "name": "Debug All",
    "active": true,
    "tosidebar": true,
    "complete": "payload",
    "x": 580,
    "y": 60,
    "wires": []
  },

  {
    "id": "split_5",
    "type": "function",
    "z": "tab_ems",
    "name": "Split 5 Values",
    "func": "var d = msg.payload;\nreturn [\n    { payload: d.Voltage     },\n    { payload: d.Current     },\n    { payload: d.Frequency   },\n    { payload: d.PowerFactor },\n    { payload: d.Energy      }\n];",
    "outputs": 5,
    "x": 580,
    "y": 160,
    "wires": [
      ["gauge_volt",  "chart_volt",  "text_volt"],
      ["gauge_curr",  "chart_curr",  "text_curr"],
      ["gauge_freq",  "chart_freq",  "text_freq"],
      ["gauge_pf",    "chart_pf",    "text_pf"],
      ["gauge_kw",    "chart_kw",    "text_kw"]
    ]
  },

  {
    "id": "alert_check",
    "type": "function",
    "z": "tab_ems",
    "name": "Alert Check",
    "func": "var d = msg.payload;\nvar alerts = [];\n\nif (d.Voltage < 200 || d.Voltage > 260)\n    alerts.push('Voltage OUT OF RANGE: ' + d.Voltage + 'V');\nif (d.Current > 80)\n    alerts.push('Current HIGH: ' + d.Current + 'A');\nif (d.Frequency < 49.5 || d.Frequency > 50.5)\n    alerts.push('Frequency UNSTABLE: ' + d.Frequency + 'Hz');\nif (d.PowerFactor < 0.8)\n    alerts.push('Low Power Factor: ' + d.PowerFactor);\n\nif (alerts.length > 0) {\n    msg.payload = alerts.join(' | ');\n    node.status({fill:'red', shape:'ring', text: alerts.length + ' alert(s)'});\n    return msg;\n}\nnode.status({fill:'green', shape:'dot', text:'All OK'});\nreturn null;",
    "outputs": 1,
    "x": 580,
    "y": 240,
    "wires": [["ui_alert", "debug_alert"]]
  },

  {
    "id": "ui_alert",
    "type": "ui_toast",
    "z": "tab_ems",
    "position": "top right",
    "displayTime": "5",
    "highlight": "",
