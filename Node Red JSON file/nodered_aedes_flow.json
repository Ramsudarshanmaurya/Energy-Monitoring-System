  {
    "id": "http_in",
    "type": "http in",
    "z": "tab_ems",
    "name": "GET /api/ems",
    "url": "/api/ems",
    "method": "get",
    "x": 120,
    "y": 320,
    "wires": [["http_respond"]]
  },

  {
    "id": "http_respond",
    "type": "function",
    "z": "tab_ems",
    "name": "Send JSON",
    "func": "var d = flow.get('ems_latest') || {\n    Voltage: 0,\n    Current: 0,\n    Frequency: 0,\n    PowerFactor: 0,\n    Energy: 0,\n    timestamp: 'No data yet'\n};\nmsg.payload = d;\nmsg.headers = {\n    'Content-Type': 'application/json',\n    'Access-Control-Allow-Origin': '*'\n};\nreturn msg;",
    "outputs": 1,
    "x": 360,
    "y": 320,
    "wires": [["http_out"]]
  },

